{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%\\.agent-auditor\\append-event.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%\\.agent-auditor\\append-event.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
